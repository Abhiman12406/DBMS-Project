# ==============================================================================
# Transit Disruption Dependency Engine - Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PostgreSQL Configuration
# ------------------------------------------------------------------------------
# Hosted PostgreSQL Connection String (Render Postgres, Neon, Supabase, RDS)
# When DATABASE_URL or POSTGRES_URL is provided, it takes precedence.
DATABASE_URL=postgres://user:password@host.render.com:5432/transit_db?sslmode=require
# POSTGRES_URL=postgres://user:password@host.render.com:5432/transit_db

# Local / Discrete Parameters (used when DATABASE_URL is not set):
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=transit_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Connection pool and security options:
# Set to 'false' only for local non-SSL postgres. Defaults to true for remote hosts.
POSTGRES_SSL=true
PG_POOL_MAX=20
# Set to 'true' only if connecting via a restrictive connection pooler (e.g. PgBouncer transaction mode)
DISABLE_DB_ROLES=false

# ------------------------------------------------------------------------------
# 2. MongoDB Configuration
# ------------------------------------------------------------------------------
# Hosted MongoDB URI (MongoDB Atlas, Render MongoDB)
# Supported variable names: MONGODB_URI, MONGO_URI, or MONGO_URL
MONGODB_URI=mongodb+srv://username:password@cluster0.mongodb.net/transit_db?retryWrites=true&w=majority
# MONGO_URI=mongodb://localhost:27017/transit_db

# Local / Discrete Parameters (used when MONGODB_URI is not set):
MONGO_INITDB_DATABASE=transit_db
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_POOL_MAX=20

# ------------------------------------------------------------------------------
# 3. Application & Server Configuration
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0

